<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plot3d="https://github.com/daipeng0809/Plot3D.Avalonia"
        x:Class="Plot3D.Demo.MainWindow"
        Title="Plot3D.Avalonia 演示 — 三维折线 / 散点"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="620"
        Background="#EEF1F5">

  <Grid ColumnDefinitions="*,318" Margin="14">

    <Border x:Name="PlotCard"
            Grid.Column="0"
            CornerRadius="12"
            ClipToBounds="True"
            Background="White"
            BoxShadow="0 8 26 0 #1F000000">
      <plot3d:Plot3DView x:Name="Plot"
                         TickCount="6"
                         ShowLegend="True"
                         XAxisTitle="X"
                         YAxisTitle="Y"
                         ZAxisTitle="Z"
                         PlotPadding="52,34,52,34" />
    </Border>

    <Border x:Name="SideCard"
            Grid.Column="1"
            Margin="14,0,0,0"
            CornerRadius="12"
            Background="White"
            BoxShadow="0 8 26 0 #1F000000">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="10">

          <TextBlock Text="显示选项" FontSize="13" FontWeight="SemiBold" />
          <CheckBox x:Name="GridCheck" Content="背景网格线" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="BoxCheck" Content="坐标框" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="PaneCheck" Content="背面面板" Click="OnToggle" />
          <CheckBox x:Name="TicksCheck" Content="刻度与标签" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="AxisTitleCheck" Content="轴标题" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="LegendCheck" Content="图例" IsChecked="True" Click="OnToggle" />

          <Border Height="1" Background="#808080" Opacity="0.25" Margin="0,6" />

          <TextBlock Text="数据点交互" FontSize="13" FontWeight="SemiBold" />
          <CheckBox x:Name="HoverCheck" Content="悬停高亮与提示" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="CrosshairCheck" Content="十字准线坐标" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="SelectCheck" Content="点击选中数据点" IsChecked="True" Click="OnToggle" />
          <CheckBox x:Name="LatestCheck" Content="最新点高亮" IsChecked="True" Click="OnToggle" />

          <TextBlock x:Name="SelectionText"
                     Text="未选中任何数据点"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Opacity="0.75" />
          <Button Content="删除选中点" HorizontalAlignment="Stretch" Click="OnDeleteSelected" />

          <Border Height="1" Background="#808080" Opacity="0.25" Margin="0,6" />

          <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="配色主题" FontSize="12" Opacity="0.72" />
          <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="浅色" />
            <ComboBoxItem Content="深色" />
          </ComboBox>

          <TextBlock Text="投影方式" FontSize="12" Opacity="0.72" />
          <ComboBox x:Name="ProjectionCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnProjectionChanged">
            <ComboBoxItem Content="正交投影" />
            <ComboBoxItem Content="透视投影" />
          </ComboBox>

          <TextBlock Text="调色板" FontSize="12" Opacity="0.72" />
          <ComboBox x:Name="PaletteCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnPaletteChanged">
            <ComboBoxItem Content="Tab10" />
            <ComboBoxItem Content="经典" />
            <ComboBoxItem Content="Set1" />
            <ComboBoxItem Content="Pastel" />
            <ComboBoxItem Content="Vivid" />
          </ComboBox>

          <CheckBox x:Name="TransparentCheck" Content="透明背景" Click="OnToggle" />

          <Border Height="1" Background="#808080" Opacity="0.25" Margin="0,6" />

          <TextBlock Text="坐标轴格式" FontSize="13" FontWeight="SemiBold" />
          <ComboBox x:Name="AxisFormatCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnAxisFormatChanged">
            <ComboBoxItem Content="数值" />
            <ComboBoxItem Content="日期（2026-10-11）" />
            <ComboBoxItem Content="时间（13:22:05）" />
            <ComboBoxItem Content="日期 + 时间（含毫秒）" />
          </ComboBox>

          <CheckBox x:Name="MsCheck" Content="时间显示到毫秒" Click="OnMillisecondsChanged" />

          <Border Height="1" Background="#808080" Opacity="0.25" Margin="0,6" />

          <TextBlock Text="图形类型" FontSize="13" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <RadioButton x:Name="LineMode" Content="折线" IsChecked="True" IsCheckedChanged="OnModeChanged" />
            <RadioButton x:Name="ScatterMode" Content="散点" IsCheckedChanged="OnModeChanged" />
            <RadioButton x:Name="BothMode" Content="折线+点" IsCheckedChanged="OnModeChanged" />
          </StackPanel>

          <TextBlock Text="刻度密度" FontSize="12" Opacity="0.72" />
          <Slider x:Name="TickSlider" Minimum="3" Maximum="12" Value="6"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="OnTickCountChanged" />

          <Border Height="1" Background="#808080" Opacity="0.25" Margin="0,6" />

          <Button Content="随机颜色" HorizontalAlignment="Stretch" Click="OnRandomColors" />
          <Button Content="重新生成数据" HorizontalAlignment="Stretch" Click="OnRegenerate" />
          <Button Content="重置视角" HorizontalAlignment="Stretch" Click="OnResetView" />

          <TextBlock Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     FontSize="12"
                     LineHeight="19"
                     Opacity="0.72"
                     Text="操作提示：左键拖动旋转，右键拖动平移，滚轮缩放，双击重置视角。悬停数据点可查看提示，左键单击选中点，右键单击打开菜单（可保存 PNG / 删除选中点）。" />

        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
